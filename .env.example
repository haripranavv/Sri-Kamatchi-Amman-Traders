# Firebase Configuration
# Copy this file to .env and fill in your Firebase project values.
# Find these at: Firebase Console → Project Settings → General → Your apps → Web app
#
# IMPORTANT: These are CLIENT-SIDE keys. They identify your Firebase project
# but do NOT grant privileged access. Security is enforced by Firestore and
# Storage security rules, not by keeping these keys secret.

FIREBASE_API_KEY=your-api-key-here
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-app-id
