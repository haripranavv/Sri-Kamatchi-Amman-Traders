rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────
    // Helper functions
    // ──────────────────────────────────────────────

    // Returns true if the request is from an authenticated user.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Returns true if the authenticated user's UID matches the given userId.
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Returns true if the authenticated user is an authorized admin.
    // Checks two server-controlled sources:
    // 1. The user profile doc has role == 'admin' (set directly in Firebase Console)
    // 2. OR the user UID exists in the server-managed /admins collection
    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ──────────────────────────────────────────────
    // admins collection (Server-managed allowlist)
    // ──────────────────────────────────────────────
    // Hardened: Customers can only check their OWN document by ID to verify admin status.
    // They cannot enumerate or list the admins collection.
    match /admins/{adminId} {
      allow get: if isAuthenticated() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    // ──────────────────────────────────────────────
    // users collection
    // ──────────────────────────────────────────────
    match /users/{userId} {
      // Any authenticated user can read their own profile. Admins can read all.
      allow read: if isOwner(userId) || isAdmin();

      // Profile creation:
      //   - The document ID must match auth UID.
      //   - The internal uid field must match auth UID.
      //   - The role field MUST be 'customer'. No self-promotion allowed.
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'customer';

      // Profile update:
      //   - Users CANNOT change their 'role' (must remain identical to existing).
      //   - Users CANNOT change their 'uid'.
      //   - Users CANNOT change their 'email'.
      //   - Admins can update any profile (including role changes).
      allow update: if (
          isOwner(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
        ) || isAdmin();

      // Only admins can delete user documents.
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // products collection
    // ──────────────────────────────────────────────
    match /products/{productId} {
      // Public catalog: anyone can read active products, admins can read all
      allow read: if resource.data.isActive == true || isAdmin();

      // Only authenticated administrators can create, update, or delete products.
      // Strict data integrity validation on write:
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.category is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
        && request.resource.data.isActive is bool;

      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // categories collection
    // ──────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // orders collection (Strictly Hardened)
    // ──────────────────────────────────────────────
    match /orders/{orderId} {
      // Users can read their own orders. Admins can read all.
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());

      // Authenticated users can create orders for themselves only.
      // Schema & Idempotency validation:
      // 1. Order document ID must match idempotencyKey and MUST NOT already exist (prevents overwrites)
      // 2. Initial status MUST be 'placed' (cannot forge 'confirmed', 'shipped', 'delivered')
      // 3. Initial paymentStatus MUST be 'pending' (cannot forge 'paid' or 'captured')
      // 4. Payment method must be a recognized mode
      // 5. Totals, delivery charges, customer contact, and delivery address must satisfy constraints
      // 6. Unexpected / privileged fields are strictly blocked
      allow create: if isAuthenticated()
        && !exists(/databases/$(database)/documents/orders/$(orderId))
        && request.resource.data.idempotencyKey == orderId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'placed'
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.paymentMethod in ['cash_on_delivery', 'enquiry']
        && request.resource.data.subtotal is number
        && request.resource.data.subtotal > 0
        && request.resource.data.deliveryCharge is number
        && request.resource.data.deliveryCharge >= 0
        && request.resource.data.total is number
        && request.resource.data.total >= request.resource.data.subtotal
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && request.resource.data.deliveryAddress is map
        && request.resource.data.deliveryAddress.addressLine1 is string
        && request.resource.data.deliveryAddress.addressLine1.size() >= 3
        && request.resource.data.deliveryAddress.city is string
        && request.resource.data.deliveryAddress.city.size() >= 2
        && request.resource.data.deliveryAddress.pincode is string
        && request.resource.data.deliveryAddress.pincode.matches('^[1-9][0-9]{5}$')
        && request.resource.data.keys().hasOnly([
          'userId', 'userEmail', 'customerName', 'phone', 'deliveryAddress',
          'items', 'subtotal', 'deliveryCharge', 'total', 'notes',
          'status', 'paymentStatus', 'paymentMethod', 'createdAt', 'updatedAt', 'idempotencyKey'
        ]);

      // Only admins can update order status or details. Customers CANNOT alter orders.
      allow update: if isAdmin();

      // Only admins can delete orders.
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // reviews collection (Hardened)
    // ──────────────────────────────────────────────
    match /reviews/{reviewId} {
      // Anyone can read reviews (public).
      allow read: if true;

      // Authenticated users can create reviews tagged with their own UID.
      // Strict schema validation prevents arbitrary document injection:
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.keys().hasOnly([
          'userId', 'userName', 'productId', 'rating', 'comment', 'createdAt'
        ]);

      // Only the review author or an admin can update/delete.
      allow update: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin())
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;

      allow delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ──────────────────────────────────────────────
    // Deny everything else by default.
    // ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
