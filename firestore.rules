rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────
    // Helper functions
    // ──────────────────────────────────────────────

    // Returns true if the request is from an authenticated user.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Returns true if the authenticated user's UID matches the given userId.
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Returns true if the authenticated user is an authorized admin.
    // Checks two server-controlled sources:
    // 1. The user profile doc has role == 'admin' (set directly in Firebase Console)
    // 2. OR the user UID exists in the server-managed /admins collection
    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ──────────────────────────────────────────────
    // admins collection (Server-managed allowlist)
    // ──────────────────────────────────────────────
    // Clients can never create, edit, or delete documents here.
    // Only project owners in the Firebase Console or Admin SDK can manage admins.
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ──────────────────────────────────────────────
    // users collection
    // ──────────────────────────────────────────────
    match /users/{userId} {
      // Any authenticated user can read their own profile. Admins can read all.
      allow read: if isOwner(userId) || isAdmin();

      // A user can create their own profile document, but:
      //   - The document ID must match their auth UID.
      //   - The role field MUST be 'customer'. No self-promotion allowed.
      allow create: if isOwner(userId)
        && request.resource.data.role == 'customer';

      // A user can update their own profile, but:
      //   - They CANNOT change their 'role' (must remain identical to existing).
      //   - They CANNOT change their 'uid'.
      //   - They CANNOT change their 'email'.
      //   - Admins can update any profile (including role changes).
      allow update: if (
          isOwner(userId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
        ) || isAdmin();

      // Only admins can delete user documents.
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // products collection
    // ──────────────────────────────────────────────
    match /products/{productId} {
      // Public catalog: anyone can read active products, admins can read all
      allow read: if true;

      // Only authenticated administrators can create, update, or delete products.
      // Basic data integrity validation on write:
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.category is string
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.stock is number
        && request.resource.data.stock >= 0
        && request.resource.data.isActive is bool;

      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // categories collection
    // ──────────────────────────────────────────────
    match /categories/{categoryId} {
      // Anyone can read categories (public).
      allow read: if true;

      // Only admins can manage categories.
      allow create, update, delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // orders collection
    // ──────────────────────────────────────────────
    match /orders/{orderId} {
      // Users can read their own orders. Admins can read all.
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());

      // Authenticated users can create orders for themselves only.
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      // Only admins can update order status or details.
      allow update: if isAdmin();

      // Only admins can delete orders.
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // reviews collection
    // ──────────────────────────────────────────────
    match /reviews/{reviewId} {
      // Anyone can read reviews (public).
      allow read: if true;

      // Authenticated users can create reviews tagged with their own UID.
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      // Only the review author or an admin can update/delete.
      allow update, delete: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ──────────────────────────────────────────────
    // Deny everything else by default.
    // ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
