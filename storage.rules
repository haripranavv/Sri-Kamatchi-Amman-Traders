rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ──────────────────────────────────────────────
    // Storage Security Rules — Sri Kamatchi Amman Traders
    // ──────────────────────────────────────────────
    // ARCHITECTURAL DESIGN NOTE:
    // To operate fully within the Firebase Spark (free) tier and avoid
    // paid Blaze plan upgrade requirements, all product images and media
    // are stored as static local assets in `assets/images/products/`
    // and served directly through Firebase Hosting with global CDN caching.
    //
    // Product-image uploads and writes through Firebase Storage are
    // INTENTIONALLY DISABLED.
    // ──────────────────────────────────────────────

    // Product images: public read preserved for any existing/legacy assets; writes denied
    match /products/{productId}/{filename} {
      allow read: if true;
      allow write: if false; // Intentionally disabled: static assets in assets/images/ are used
    }

    // User avatars: public read preserved; writes disabled
    match /users/{userId}/{filename} {
      allow read: if true;
      allow write: if false;
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
