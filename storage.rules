rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ──────────────────────────────────────────────
    // Helper: validate image file type and size
    // ──────────────────────────────────────────────
    function isValidProductImage() {
      return request.resource.size < 5 * 1024 * 1024  // 5 MB max
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isValidAvatar() {
      return request.resource.size < 2 * 1024 * 1024  // 2 MB max
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // ──────────────────────────────────────────────
    // Product images
    // ──────────────────────────────────────────────
    // Publicly readable so customers can see product photos.
    // Uploads restricted to authenticated users with valid image format and size.
    match /products/{productId}/{filename} {
      allow read: if true;
      allow write: if request.auth != null
        && isValidProductImage();
    }

    // ──────────────────────────────────────────────
    // User avatars
    // ──────────────────────────────────────────────
    match /users/{userId}/{filename} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && isValidAvatar();
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
